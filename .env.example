# =============================================
# FRONTEND (exposed to browser via VITE_ prefix)
# Only these variables are safe for the client bundle
# =============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
VITE_APP_URL=http://localhost:5173

# =============================================
# SERVER-ONLY (Supabase Edge Functions / Backend)
# These MUST NOT start with VITE_ — never exposed to the browser
# =============================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
PLUGGY_CLIENT_ID=your-pluggy-client-id
PLUGGY_CLIENT_SECRET=your-pluggy-client-secret
GEMINI_API_KEY=your-gemini-api-key
